rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // Core Authorization Helpers
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDocument() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAuthenticated() && hasUserDocument() && getUserData().role == 'admin';
    }

    function hasPermission(permissionKey) {
      return isAuthenticated() && hasUserDocument() && (
        getUserData().role == 'admin' ||
        getUserData().get('permissions', {}).get(permissionKey, false) == true
      );
    }

    function hasModuleAccess(moduleKey) {
      return isAuthenticated() && hasUserDocument() && (
        getUserData().role == 'admin' ||
        moduleKey in getUserData().get('permissions', {}).get('allowedModules', [])
      );
    }

    // ==========================================
    // Schema & Type Validation Helpers
    // ==========================================
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidInt(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    function isValidBool(val) {
      return val is bool;
    }

    // ==========================================
    // Collection Rules & Validations
    // ==========================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'assignedOrder', 'presetName'])
      );

      // Validate user structure on write
      // Checks role enums and limits displayNames
      match / {
        allow write: if request.resource.data.role in ['admin', 'user', 'order_leader'] &&
                     (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 0, 100)) &&
                     isValidString(request.resource.data.email, 3, 100);
      }
    }

    match /members/{memberId} {
      allow read: if true; // Public excuse form lists members
      allow write: if isSuperAdmin();

      match / {
        allow write: if isValidString(request.resource.data.firstName, 1, 50) &&
                     isValidString(request.resource.data.lastName, 1, 50) &&
                     request.resource.data.status in ['active', 'inactive', 'archived'] &&
                     isValidString(request.resource.data.rank, 1, 50);
      }
    }
    
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if hasPermission('canManageSchedules');

      match / {
        allow write: if isValidString(request.resource.data.date, 10, 10) && // "YYYY-MM-DD"
                     isValidString(request.resource.data.startTime, 5, 8);
      }
    }
    
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canTakeAttendance');
    }
    
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canTakeAttendance');

      match / {
        allow write: if request.resource.data.status in ['present', 'late', 'absent', 'excused', 'observer', 'formation', 'alumni'] &&
                     (!('remarks' in request.resource.data) || isValidString(request.resource.data.remarks, 0, 500));
      }
    }

    match /settings/{settingsId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /scheduleTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('canManageSchedules');
    }

    match /auditLogs/{logId} {
      allow read: if hasPermission('canViewAuditTrail');
      allow create: if isAuthenticated();
      allow update, delete: if false;

      match / {
        allow create: if isValidString(request.resource.data.action, 1, 100) &&
                      isValidString(request.resource.data.details, 1, 1000);
      }
    }

    match /schedulePublications/{pubId} {
      allow read: if true;
      allow write: if hasPermission('canManageSchedules');
    }

    match /counters/{counterId} {
      allow get: if true;
      allow update: if isAuthenticated() || (
        request.resource.data.get('currentSeq', 0) == resource.data.get('currentSeq', 0) + 1
      );
      allow create: if isAuthenticated() || (
        request.resource.data.get('currentSeq', 0) == 1
      );
      allow delete, list: if isSuperAdmin();
    }

    match /excuseRequests/{excuseId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow delete: if isSuperAdmin();

      match / {
        allow create: if isValidString(request.resource.data.reason, 1, 1000) &&
                      isValidString(request.resource.data.memberId, 1, 100);
      }
    }

    match /excuseStatus/{trackingNumber} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isSuperAdmin();

      match / {
        allow write: if request.resource.data.status in ['pending', 'approved', 'rejected'] &&
                     isValidString(request.resource.data.reason, 1, 1000) &&
                     (!('adminRemarks' in request.resource.data) || isValidString(request.resource.data.adminRemarks, 0, 1000)) &&
                     (!('rejectionReason' in request.resource.data) || isValidString(request.resource.data.rejectionReason, 0, 1000));
      }
    }

    // ==========================================
    // Finance Module Collections
    // ==========================================
    match /financeIncome/{incomeId} {
      allow read: if hasPermission('canViewFinanceDashboard') || hasPermission('canViewFinanceReports');
      allow create: if hasPermission('canAddIncome');
      allow update: if hasPermission('canEditIncome');
      allow delete: if hasPermission('canDeleteIncome');
    }
    
    match /financeExpenses/{expenseId} {
      allow read: if hasPermission('canViewFinanceDashboard') || hasPermission('canViewFinanceReports');
      allow create: if hasPermission('canViewFinanceDashboard') || hasPermission('canCreateFundRequest');
      allow update: if hasPermission('canViewFinanceDashboard');
      allow delete: if isSuperAdmin();
    }

    match /financeCategories/{categoryId} {
      allow read: if hasPermission('canViewFinanceDashboard');
      allow write: if hasPermission('canManageFinanceCategories');
    }

    match /financeFundRequests/{requestId} {
      allow read: if hasPermission('canViewFinanceDashboard');
      allow create: if hasPermission('canCreateFundRequest');
      allow update: if hasPermission('canApproveFundRequest') || 
                    hasPermission('canRejectFundRequest') || 
                    hasPermission('canReleaseFunds') || 
                    hasPermission('canSubmitLiquidation') || 
                    hasPermission('canReviewLiquidation') ||
                    hasPermission('canCreateFundRequest');
      allow delete: if isSuperAdmin();
    }

    match /financePeriods/{periodId} {
      allow read: if hasPermission('canViewFinanceDashboard');
      allow create: if hasPermission('canCloseFinancePeriod');
      allow update: if hasPermission('canCloseFinancePeriod') || hasPermission('canReopenFinancePeriod');
      allow delete: if isSuperAdmin();
    }
  }
}
