rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if current user is an admin or authorized role
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'order_leader');
    }

    // Helper function to check if the user has finance module access
    function hasFinanceAccess() {
      return isAuthenticated() &&
             (
               request.auth.token.email.lower() == 'coordinator@mas.com' ||
               (
                 exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                 (
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'order_leader' ||
                   'finance' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', {}).get('allowedModules', [])
                 )
               )
             );
    }

    // users collection: Any authenticated user can read profiles; admins/authorized managers can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAuthenticated();
    }

    // members collection: Authenticated users can read, authorized users can modify
    match /members/{memberId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // schedules collection: Authenticated users can read, authorized users can modify
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // attendanceSessions collection: Authenticated users can read, create, and update attendance sessions
    match /attendanceSessions/{sessionId} {
      allow read, create, update, delete: if isAuthenticated();
    }
    
    // attendance collection: Authenticated users (attendance takers & admins) can read and save attendance
    match /attendance/{attendanceId} {
      allow read, write, delete: if isAuthenticated();
    }

    // settings collection: Authenticated users can read settings, authorized users can update presets
    match /settings/{settingsId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // scheduleTemplates collection: Authenticated users can read, authorized users can modify
    match /scheduleTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // auditLogs collection: Authenticated users can log actions and admins can view
    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // schedulePublications collection: Public can read, authenticated users can write
    match /schedulePublications/{pubId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // counters collection: public can read/write to generate sequential tracking numbers
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // excuseRequests collection: public can create and read (to check status), authenticated users can update
    match /excuseRequests/{excuseId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    // Finance Module Collections
    match /financeIncome/{incomeId} {
      allow read, write: if hasFinanceAccess();
    }
    
    match /financeExpenses/{expenseId} {
      allow read, write: if hasFinanceAccess();
    }

    match /financeCategories/{categoryId} {
      allow read, write: if hasFinanceAccess();
    }

    match /financeFundRequests/{requestId} {
      allow read, write: if hasFinanceAccess();
    }

    match /financePeriods/{periodId} {
      allow read, write: if hasFinanceAccess();
    }
  }
}
