rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if current user is an admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users collection: Any authenticated user can read profiles, but only admins can create/update/delete
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // members collection: Authenticated users can read, admins can modify
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // schedules collection: Authenticated users can read, admins can modify
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // attendanceSessions collection: Authenticated users can read, create, and update attendance sessions
    match /attendanceSessions/{sessionId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // attendance collection: Authenticated users (attendance takers & admins) can read and save attendance
    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }

    // settings collection: Authenticated users can read settings, admins can update
    match /settings/{settingsId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // scheduleTemplates collection: Authenticated users can read, admins can modify
    match /scheduleTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // auditLogs collection: Authenticated users can log actions and admins can view
    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
